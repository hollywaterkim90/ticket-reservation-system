# docker-compose 실행에 필요한 환경변수 템플릿
# 사용법: cp .env.example .env

# Kafka 브로커 이미지 버전 (confluentinc/cp-kafka)
KAFKA_VERSION='7.7.0'

# Elasticsearch / Kibana 이미지 버전 (두 서비스가 동일 버전을 사용)
ELASTICSEARCH_VERSION='8.13.4'

# init-kafka 컨테이너가 생성할 토픽의 파티션 수
# 컨슈머 병렬도의 상한이 됨 (파티션 N개 → 컨슈머 최대 N개)
# KEDA maxReplicaCount(3)와 일치시켜야 스케일아웃이 의미를 가짐
KAFKA_TOPIC_PARTITIONS='3'